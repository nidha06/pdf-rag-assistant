# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=

# Set this only when the deployment platform cannot infer its public URL.
# AUTH_URL=https://your-domain.example

# GitHub OAuth App credentials
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth Web application credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# SMTP mail delivery for password-reset OTPs. For Gmail use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="PDF Assistant <your-email@example.com>"

# Existing application services
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
GEMINI_API_KEY=
